# Enterprise Compliance AI Assistant - Backend Environment Template

# Gemini API Configuration (Agentic Workflow / Reasoning Engine)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Groq API Configuration (Outer Response LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# FastAPI Server Port
PORT=8000
